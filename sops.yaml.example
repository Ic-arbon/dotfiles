# sops 配置文件（仅含公钥，可安全提交）。
#
# 约定：
#   - 每个 age recipient 使用独立的 YAML anchor；
#   - common 密文允许所有机器解密；
#   - 机器专属密文只允许对应机器的 keys。
#
# 添加新机器后，需要在任一已授权机器上运行：
#   sops updatekeys secrets/common/secrets.yaml

keys:
  - &hosts:
      __AGE_HOST_KEYS__

creation_rules:
  - path_regex: ^secrets/common/secrets\.yaml$
    key_groups:
      - age:
          __COMMON_HOST_ANCHORS__
